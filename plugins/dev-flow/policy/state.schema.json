{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "mode", "featureId", "revision", "lifecycle", "scope", "steps", "humanGates", "artifacts", "verification", "featureCheck", "blockingFindings", "logicComplete", "lastUpdatedBy"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "mode": { "enum": ["intake", "routed"] },
    "featureId": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "lifecycle": { "enum": ["active", "paused", "finalized", "abandoned"] },
    "objective": { "type": "string", "minLength": 1 },
    "scope": { "type": "object", "required": ["inScope", "outOfScope"], "additionalProperties": false, "properties": { "inScope": { "type": "array", "items": { "type": "string" } }, "outOfScope": { "type": "array", "items": { "type": "string" } } } },
    "route": { "enum": ["xs", "s", "light-m", "standard-m", "light-l", "standard-l"] },
    "classification": { "$ref": "#/$defs/classification" },
    "classificationBasis": { "$ref": "#/$defs/classificationBasis" },
    "obligations": { "type": "array", "items": { "$ref": "#/$defs/obligation" } },
    "decisionLedger": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
    "checkpoints": { "type": "array", "items": { "$ref": "#/$defs/checkpoint" } },
    "workflowCapabilities": { "$ref": "#/$defs/workflowCapabilities" },
    "traceability": { "$ref": "#/$defs/traceabilityPointer" },
    "review": { "$ref": "#/$defs/reviewPointer" },
    "implementationUnits": { "type": "array", "items": { "$ref": "#/$defs/implementationUnit" } },
    "rollbackGate": { "$ref": "#/$defs/rollbackGate" },
    "interactions": { "type": "object" },
    "currentStage": { "type": "string", "minLength": 1 },
    "repair": { "type": "object" },
    "businessFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "startBusinessFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "deliveryBaseline": { "$ref": "#/$defs/deliveryBaseline" },
    "deliverySnapshot": { "$ref": "#/$defs/deliverySnapshot" },
    "steps": { "type": "object", "additionalProperties": { "type": "object", "required": ["status"], "properties": { "status": { "enum": ["pending", "satisfied"] }, "evidence": {} } } },
    "humanGates": { "type": "object" },
    "artifacts": { "type": "object", "additionalProperties": { "$ref": "#/$defs/artifact" } },
    "verification": { "type": "object", "required": ["attempts"], "properties": { "attempts": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "integer", "minimum": 1 }, "output": { "type": "string" }, "outputTail": { "type": "string", "maxLength": 4000 }, "outputPath": { "type": "string", "minLength": 1 }, "phase": { "enum": ["preflight", "forward"] } } } } } },
    "featureCheck": { "type": "object" },
    "blockingFindings": { "type": "array" },
    "logicComplete": { "type": "boolean" },
    "lastUpdatedBy": { "type": "object", "required": ["host", "pluginVersion"], "properties": { "host": { "enum": ["claude", "codex"] }, "pluginVersion": { "type": "string" } } }
  },
  "allOf": [
    { "if": { "properties": { "mode": { "const": "intake" } } }, "then": { "not": { "required": ["route", "classificationBasis", "obligations"] } } },
    { "if": { "properties": { "mode": { "const": "routed" } } }, "then": { "required": ["route", "classification", "classificationBasis", "obligations"] } }
  ],
  "$defs": {
    "classification": { "type": "object", "required": ["level", "topology", "riskLabels", "acceptanceAssistSuggested"], "additionalProperties": false, "properties": { "level": { "enum": ["XS", "S", "M", "L"] }, "topology": { "enum": ["local", "shared-contract", "multi-chain", "coordinated-rollback"] }, "execution": { "enum": ["light", "standard"] }, "requirements": { "enum": ["missing-or-unclear", "documented-unconfirmed", "provided-confirmed"] }, "riskLabels": { "type": "array", "items": { "enum": ["security", "data", "money", "external", "availability", "critical_correctness", "irreversible_consequence"] } }, "acceptanceAssistSuggested": { "type": "boolean" }, "classificationBasis": { "$ref": "#/$defs/classificationBasis" } } },
    "classificationBasis": { "type": "object", "required": ["scopeFacts", "topologyFacts", "uncertaintyFacts", "riskFacts", "decisionRefs"], "additionalProperties": false, "properties": { "scopeFacts": { "type": "array", "items": { "type": "string" } }, "topologyFacts": { "type": "array", "items": { "type": "string" } }, "uncertaintyFacts": { "type": "array", "items": { "type": "string" } }, "riskFacts": { "type": "object", "propertyNames": { "enum": ["security", "data", "money", "external", "availability", "critical_correctness", "irreversible_consequence"] }, "additionalProperties": { "type": "array", "items": { "type": "string" } } }, "decisionRefs": { "type": "array", "items": { "type": "string" } }, "signals": { "$ref": "#/$defs/classificationSignals" } } },
    "classificationSignals": { "type": "object", "additionalProperties": false, "required": ["impactScope", "sharedContract", "independentChains", "coordinatedRollback", "requirements", "formalControls"], "properties": { "impactScope": { "enum": ["single-location", "single-module", "cross-module"] }, "sharedContract": { "type": "boolean" }, "independentChains": { "type": "integer", "minimum": 1 }, "coordinatedRollback": { "type": "boolean" }, "requirements": { "enum": ["missing-or-unclear", "documented-unconfirmed", "provided-confirmed"] }, "formalControls": { "type": "array", "items": { "enum": ["trace", "independent-review", "multiple-rollback-units"] } } } },
    "workflowCapabilities": { "type": "object", "additionalProperties": false, "required": ["trace", "review", "checkpoints", "rollbackExecution"], "properties": { "trace": { "enum": [0, 1] }, "review": { "enum": [0, 1] }, "checkpoints": { "enum": [0, 1] }, "rollbackExecution": { "enum": [0, 1] } } },
    "traceabilityPointer": { "type": "object", "additionalProperties": false, "required": ["path", "sha256", "revision", "summary"], "properties": { "path": { "type": "string", "pattern": "^traceability/snapshots/[a-f0-9]{64}\\.json$" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "revision": { "type": "integer", "minimum": 0 }, "summary": { "$ref": "#/$defs/traceSummary" } } },
    "traceSummary": { "type": "object", "additionalProperties": false, "required": ["total", "current", "stale", "tombstoned"], "properties": { "total": { "type": "integer", "minimum": 0 }, "current": { "type": "integer", "minimum": 0 }, "stale": { "type": "integer", "minimum": 0 }, "tombstoned": { "type": "integer", "minimum": 0 } } },
    "reviewPointer": { "type": "object", "additionalProperties": false, "required": ["path", "sha256", "revision", "summary"], "properties": { "path": { "type": "string", "pattern": "^review/snapshots/[a-f0-9]{64}\\.json$" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "revision": { "type": "integer", "minimum": 0 }, "summary": { "$ref": "#/$defs/reviewSummary" } } },
    "reviewSummary": { "type": "object", "additionalProperties": false, "required": ["batches", "current", "stale", "open", "complete"], "properties": { "batches": { "type": "integer", "minimum": 0 }, "current": { "type": "integer", "minimum": 0 }, "stale": { "type": "integer", "minimum": 0 }, "open": { "type": "integer", "minimum": 0 }, "complete": { "type": "integer", "minimum": 0 } } },
    "artifact": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
    "implementationUnit": { "type": "object", "additionalProperties": false, "required": ["unitId", "status", "basisHash"], "properties": { "unitId": { "type": "string", "pattern": "^RU-[0-9]{3,}$" }, "status": { "enum": ["pending", "active", "verified", "checkpointed", "rolled_back"] }, "basisHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "startedFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "checkpointId": { "type": "string", "minLength": 1 }, "beginNonce": { "type": "string", "minLength": 1 } } },
    "rollbackGate": { "type": "object", "additionalProperties": false, "required": ["status", "targetCheckpointId", "targetUnitId", "previewBasisHash", "interactionId", "stateRevision", "presentedAt"], "properties": { "status": { "enum": ["pending", "confirmed"] }, "targetCheckpointId": { "type": "string", "minLength": 1 }, "targetUnitId": { "type": "string", "pattern": "^RU-[0-9]{3,}$" }, "previewBasisHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "interactionId": { "type": "string", "minLength": 1 }, "stateRevision": { "type": "integer", "minimum": 0 }, "presentedAt": { "type": "string", "minLength": 1 }, "confirmedAt": { "type": "string", "minLength": 1 } } },
    "deliveryBaseline": { "type": "object", "additionalProperties": false, "required": ["dirtyPaths"], "properties": { "gitHead": { "type": "string" }, "dirtyPaths": { "type": "array", "items": { "type": "string" } } } },
    "deliverySnapshot": { "type": "object", "additionalProperties": false, "required": ["manifestPath", "manifestSha256", "patchPath", "patchSha256", "baseHead", "files"], "properties": { "manifestPath": { "type": "string", "minLength": 1 }, "manifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "patchPath": { "type": "string", "minLength": 1 }, "patchSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "baseHead": { "type": "string", "minLength": 1 }, "files": { "type": "array", "items": { "type": "string" } } } },
    "obligation": { "type": "object", "required": ["id", "kind", "source", "basisHash", "status", "reason"], "properties": { "id": { "type": "string" }, "kind": { "enum": ["review", "verification", "rollback", "approval", "checkpoint"] }, "source": { "enum": ["route", "risk", "topology", "uncertainty"] }, "basisHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "status": { "enum": ["pending", "satisfied", "stale"] }, "reason": { "type": "string" } } },
    "decision": { "type": "object", "required": ["id", "question", "status"], "properties": { "id": { "type": "string" }, "question": { "type": "string" }, "status": { "enum": ["open", "resolved", "merged", "dismissed"] }, "source": { "const": "grill" } } },
    "checkpoint": { "type": "object", "required": ["checkpointId", "stage", "capturedAt", "fingerprint", "files", "basisHash"], "properties": { "checkpointId": { "type": "string", "pattern": "^AUTO-[0-9a-f-]{10,}$" }, "stage": { "type": "string", "minLength": 1 }, "capturedAt": { "type": "string", "minLength": 1 }, "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "files": { "type": "array", "items": { "type": "string" } }, "basisHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }
  }
}
