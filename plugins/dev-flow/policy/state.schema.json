{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dev-flow/state.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "featureId", "revision", "lifecycle", "scope", "evidenceFreshness", "steps", "humanGates", "artifacts", "verification", "blockingFindings", "logicComplete", "lastUpdatedBy", "archivedCollections"],
  "properties": {
    "schemaVersion": { "const": 6 },
    "archivedCollections": { "$ref": "#/$defs/archivedCollections" },
    "governance": { "$ref": "#/$defs/governanceLedger" },
    "mode": { "enum": ["intake", "routed"] },
    "featureId": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "lifecycle": { "enum": ["active", "paused", "finalized", "abandoned"] },
    "objective": { "type": "string" },
    "investigationSummary": { "type": "string" },
    "scope": {
      "type": "object",
      "required": ["inScope", "outOfScope"],
      "additionalProperties": false,
      "properties": {
        "inScope": { "type": "array", "items": { "type": "string" } },
        "outOfScope": { "type": "array", "items": { "type": "string" } }
      }
    },
    "route": { "enum": ["xs", "s", "m", "l"] },
    "classification": { "$ref": "#/$defs/classification" },
    "classificationBasis": { "$ref": "#/$defs/classificationBasis" },
    "routeConfirmation": { "type": "object" },
    "pendingDecision": { "type": "object" },
    "obligations": { "type": "array" },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseHead", "baseBranch", "observedHead", "startedDirty", "ownership", "ownershipSource", "observedCommits", "observedPathFingerprints", "lastWorkspaceFingerprint", "reconciliationStatus"],
      "properties": {
        "baseHead": { "type": "string" },
        "baseBranch": { "type": "string" },
        "observedHead": { "type": "string" },
        "startedDirty": { "type": "object" },
        "ownership": { "type": "object", "additionalProperties": { "enum": ["feature", "excluded"] } },
        "ownershipSource": { "type": "object", "additionalProperties": { "enum": ["user-adopted", "trusted-hook", "startup-excluded"] } },
        "observedCommits": { "type": "array" },
        "observedPathFingerprints": { "type": "object", "additionalProperties": { "type": "string" } },
        "unownedPaths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "lastWorkspaceFingerprint": { "type": "string" },
        "reconciliationStatus": { "enum": ["current", "required", "blocked"] }
      }
    },
    "evidenceFreshness": {
      "type": "object",
      "required": ["review", "verification", "checkpoint", "implementation"],
      "additionalProperties": false,
      "properties": {
        "review": { "enum": ["missing", "current", "stale"] },
        "verification": { "enum": ["missing", "current", "stale"] },
        "checkpoint": { "enum": ["missing", "current", "stale"] },
        "implementation": { "const": "current" }
      }
    },
    "steps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "properties": { "status": { "enum": ["pending", "satisfied"] }, "evidence": {} },
        "additionalProperties": false
      }
    },
    "humanGates": { "type": "object" },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": { "path": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
        "additionalProperties": false
      }
    },
    "traceability": { "type": "object" },
    "review": { "type": "object" },
    "checkpoints": { "type": "array" },
    "implementationUnits": { "type": "array" },
    "verification": { "type": "object", "required": ["attempts"] },
    "interactions": { "type": "object" },
    "workflowCapabilities": {
      "type": "object",
      "required": ["trace", "review", "checkpoints", "rollbackExecution"],
      "properties": {
        "trace": { "enum": [0, 1] }, "review": { "enum": [0, 1] },
        "checkpoints": { "enum": [0, 1] }, "rollbackExecution": { "enum": [0, 1] }
      },
      "additionalProperties": false
    },
    "rollbackGate": { "type": "object" },
    "businessFingerprint": { "type": "string" },
    "startBusinessFingerprint": { "type": "string" },
    "deliveryBaseline": { "type": "object" },
    "deliverySnapshot": { "type": "object" },
    "abandonment": { "type": "object" },
    "repair": { "type": "object" },
    "blockingFindings": { "type": "array" },
    "logicComplete": { "type": "boolean" },
    "lastUpdatedBy": {
      "type": "object",
      "required": ["host", "pluginVersion"],
      "properties": { "host": { "enum": ["claude", "codex"] }, "pluginVersion": { "type": "string" } },
      "additionalProperties": false
    },
    "executionSemanticBasisHash": { "type": "string" },
    "resumeSummary": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "intake" } } },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["route"] },
            { "required": ["classification"] },
            { "required": ["classificationBasis"] },
            { "required": ["obligations"] }
          ]
        }
      }
    },
    { "if": { "properties": { "mode": { "const": "routed" } } }, "then": { "required": ["route", "classification", "classificationBasis", "obligations"] } }
  ],
  "$defs": {
    "archivedCollections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "featureId", "pointer"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "featureId": { "type": "string", "minLength": 1 },
        "pointer": { "type": "object" },
        "workspaceLineage": { "type": "object" },
        "interactionLedger": { "type": "object" },
        "governanceLedger": { "type": "object" },
        "verificationLedger": { "type": "object" },
        "repairLedger": { "type": "object" }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "topology", "riskLabels", "acceptanceAssistSuggested", "controls", "orderedRoute", "routeConfirmationRequired"],
      "properties": {
        "level": { "enum": ["XS", "S", "M", "L"] },
        "topology": { "enum": ["local", "shared-contract", "multi-chain", "coordinated-rollback"] },
        "requirements": { "enum": ["missing-or-unclear", "documented-unconfirmed", "provided-confirmed"] },
        "riskLabels": { "type": "array" },
        "acceptanceAssistSuggested": { "type": "boolean" },
        "classificationBasis": { "$ref": "#/$defs/classificationBasis" },
        "controls": { "$ref": "#/$defs/controls" },
        "orderedRoute": { "type": "array", "items": { "type": "string" } },
        "routeConfirmationRequired": { "type": "boolean" }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements", "plan", "trace", "planReview", "reviewRoles", "executionApproval", "checkpoints", "recovery", "codeReview", "verification", "reasons"],
      "properties": {
        "requirements": { "type": "boolean" },
        "plan": { "enum": ["locate", "brief", "formal"] },
        "trace": { "type": "boolean" },
        "planReview": { "type": "boolean" },
        "reviewRoles": { "type": "array" },
        "executionApproval": { "type": "boolean" },
        "checkpoints": { "enum": ["baseline", "unit-chain"] },
        "recovery": { "type": "array" },
        "codeReview": { "enum": ["none", "focused", "independent", "full"] },
        "verification": { "type": "array", "items": { "enum": ["targeted", "behavior", "integration", "full"] } },
        "reasons": { "type": "object" }
      }
    },
    "classificationBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scopeFactRefs", "topologyFactRefs", "uncertaintyFactRefs", "riskFactRefs", "decisionRefs", "signals"],
      "properties": {
        "scopeFactRefs": { "type": "array", "items": { "type": "string" } },
        "topologyFactRefs": { "type": "array", "items": { "type": "string" } },
        "uncertaintyFactRefs": { "type": "array", "items": { "type": "string" } },
        "riskFactRefs": { "type": "object" },
        "decisionRefs": { "type": "array", "items": { "type": "string" } },
        "controlEnhancements": { "$ref": "#/$defs/controlEnhancements" },
        "signals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["changeSurface", "behaviorChange", "topology", "unitCount", "requirements", "operationalRecovery", "executableRollback"],
          "properties": {
            "changeSurface": { "enum": ["single-site", "single-component", "multi-component", "system-wide"] },
            "behaviorChange": { "enum": ["mechanical", "bounded-rule", "new-capability", "systemic-change"] },
            "topology": { "enum": ["local", "shared-contract", "multi-chain", "coordinated-rollback"] },
            "unitCount": { "type": "integer", "minimum": 1 },
            "requirements": { "enum": ["missing-or-unclear", "documented-unconfirmed", "provided-confirmed"] },
            "operationalRecovery": { "type": "boolean" },
            "executableRollback": { "type": "boolean" },
            "upwardLevel": { "enum": ["XS", "S", "M", "L"] }
          }
        }
      }
    },
    "controlEnhancements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requirements": { "const": true },
        "plan": { "enum": ["brief", "formal"] },
        "trace": { "const": true },
        "planReview": { "const": true },
        "reviewRoles": { "type": "array", "uniqueItems": true, "items": { "enum": ["code-quality", "requirement-fidelity", "requirements-coverage", "architecture-testability", "rollback-operability", "security", "data-irreversibility", "money-safety", "contract-failure", "recovery-observability", "critical-correctness"] } },
        "executionApproval": { "const": true },
        "checkpoints": { "const": "unit-chain" },
        "recovery": { "type": "array", "uniqueItems": true, "items": { "enum": ["operational-strategy", "executable-rollback", "irreversible-compensation"] } },
        "codeReview": { "enum": ["focused", "independent", "full"] },
        "verification": { "type": "array", "uniqueItems": true, "items": { "enum": ["targeted", "behavior", "integration", "full"] } }
      }
    },
    "governanceLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisions", "claims", "authorizations", "credentials", "repositoryFacts"],
      "properties": {
        "decisions": { "type": "array", "items": { "$ref": "#/$defs/governanceDecision" } },
        "claims": { "type": "array", "items": { "$ref": "#/$defs/governanceClaim" } },
        "authorizations": { "type": "array", "items": { "$ref": "#/$defs/governanceAuthorization" } },
        "credentials": { "type": "array", "items": { "$ref": "#/$defs/governanceCredential" } },
        "repositoryFacts": { "type": "array", "items": { "$ref": "#/$defs/governanceRepositoryFact" } }
      }
    },
    "recordBasis": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sha256"],
          "properties": { "kind": { "const": "content" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "eventId"],
          "properties": { "kind": { "const": "event" }, "eventId": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sliceKey", "sliceHash"],
          "properties": { "kind": { "const": "slice" }, "sliceKey": { "type": "string", "minLength": 1 }, "sliceHash": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "governanceDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordId", "kind", "question", "conclusion"],
      "properties": {
        "recordId": { "type": "string" },
        "kind": { "const": "decision" },
        "question": { "type": "string" },
        "conclusion": { "type": "string" },
        "credentialId": { "type": "string" },
        "supersededBy": { "type": "string" },
        "basis": { "$ref": "#/$defs/recordBasis" },
        "recordedAt": { "type": "string" }
      }
    },
    "governanceClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordId", "kind", "claimType", "subject"],
      "properties": {
        "recordId": { "type": "string" },
        "kind": { "const": "claim" },
        "claimType": { "enum": ["review-complete", "verification-current", "checkpoint-current", "approval-current", "risk-accepted"] },
        "subject": { "type": "string" },
        "supersededBy": { "type": "string" },
        "basis": { "$ref": "#/$defs/recordBasis" },
        "recordedAt": { "type": "string" }
      }
    },
    "governanceAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordId", "kind", "authorizationType", "target"],
      "properties": {
        "recordId": { "type": "string" },
        "kind": { "const": "authorization" },
        "authorizationType": { "enum": ["risk-acceptance", "dangerous-command", "approval"] },
        "target": { "type": "string" },
        "credentialId": { "type": "string" },
        "supersededBy": { "type": "string" },
        "basis": { "$ref": "#/$defs/recordBasis" },
        "recordedAt": { "type": "string" }
      }
    },
    "governanceCredential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordId", "kind", "source", "host", "interactionId"],
      "properties": {
        "recordId": { "type": "string" },
        "kind": { "const": "credential" },
        "source": { "enum": ["native-form", "text"] },
        "host": { "enum": ["claude", "codex"] },
        "interactionId": { "type": "string" },
        "optionId": { "type": "string" },
        "rawText": { "type": "string" },
        "supersededBy": { "type": "string" },
        "basis": { "$ref": "#/$defs/recordBasis" },
        "recordedAt": { "type": "string" }
      }
    },
    "governanceRepositoryFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordId", "kind", "assertion", "location", "observedFingerprint"],
      "properties": {
        "recordId": { "type": "string" },
        "kind": { "const": "repository-fact" },
        "assertion": { "type": "string" },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["positive", "negative"] },
            "path": { "type": "string" },
            "anchor": { "type": "string" },
            "checkedScope": { "type": "array", "items": { "type": "string" } },
            "conditions": { "type": "string" }
          }
        },
        "observedFingerprint": { "type": "string" },
        "observation": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["kind", "path"], "properties": { "kind": { "const": "file-exists" }, "path": { "type": "string", "minLength": 1 } } },
            { "type": "object", "additionalProperties": false, "required": ["kind", "path", "text"], "properties": { "kind": { "const": "text-present" }, "path": { "type": "string", "minLength": 1 }, "text": { "type": "string", "minLength": 1 }, "occurrence": { "type": "integer", "minimum": 1 } } },
            { "type": "object", "additionalProperties": false, "required": ["kind", "path", "symbol"], "properties": { "kind": { "const": "symbol-present" }, "path": { "type": "string", "minLength": 1 }, "symbol": { "type": "string", "minLength": 1 } } },
            { "type": "object", "additionalProperties": false, "required": ["kind", "path", "pointer", "expected"], "properties": { "kind": { "const": "json-value" }, "path": { "type": "string", "minLength": 1 }, "pointer": { "type": "string", "pattern": "^/" }, "expected": {} } },
            { "type": "object", "additionalProperties": false, "required": ["kind", "checkedScope", "pattern", "patternKind"], "properties": { "kind": { "const": "search-absent" }, "checkedScope": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }, "pattern": { "type": "string", "minLength": 1 }, "patternKind": { "enum": ["literal", "regex"] } } }
          ]
        },
        "supersededBy": { "type": "string" },
        "basis": { "$ref": "#/$defs/recordBasis" },
        "recordedAt": { "type": "string" }
      }
    }
  }
}
