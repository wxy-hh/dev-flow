{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dev-flow/traceability.schema.json",
  "$defs": {
    "inlineVerificationCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "cwd": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).*$" }
      }
    },
    "verificationCommandRef": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "$ref": "#/$defs/inlineVerificationCommand" }
      ]
    },
    "verificationDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["behavior-test", "type-check", "rule-check", "file-check", "human-acceptance"] },
        "reason": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 }
      }
    },
    "traceDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes"],
      "properties": { "nodes": { "type": "array", "items": { "$ref": "#/$defs/traceNodeInput" } } }
    },
    "traceNodeInput": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": { "kind": { "const": "requirement" }, "id": { "type": "string", "pattern": "^REQ-[0-9]{3,}$" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "parentRequirement"],
          "properties": {
            "kind": { "const": "acceptance-criterion" },
            "id": { "type": "string", "pattern": "^AC-[0-9]{3,}$" },
            "parentRequirement": { "type": "string", "pattern": "^REQ-[0-9]{3,}$" },
            "verificationDisposition": { "$ref": "#/$defs/verificationDisposition" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "covers", "implementationUnit"],
          "properties": {
            "kind": { "const": "task" },
            "id": { "type": "string", "pattern": "^TASK-[0-9]{3,}$" },
            "covers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^(REQ|AC)-[0-9]{3,}$" } },
            "implementationUnit": { "type": "string", "pattern": "^UNIT-[0-9]{3,}$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "verifies"],
          "properties": {
            "kind": { "const": "test" },
            "id": { "type": "string", "pattern": "^TEST-[0-9]{3,}$" },
            "verifies": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^AC-[0-9]{3,}$" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "tasks", "dependsOn", "fileScope", "covers", "forwardVerification", "rollbackVerification"],
          "properties": {
            "kind": { "const": "rollback" },
            "id": { "type": "string", "pattern": "^RU-[0-9]{3,}$" },
            "tasks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^TASK-[0-9]{3,}$" } },
            "dependsOn": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^RU-[0-9]{3,}$" } },
            "fileScope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "covers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^(REQ|AC)-[0-9]{3,}$" } },
            "forwardVerification": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/verificationCommandRef" } },
            "rollbackVerification": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/verificationCommandRef" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "tasks", "dependsOn", "fileScope", "covers", "forwardVerification"],
          "properties": {
            "kind": { "const": "implementation-unit" },
            "id": { "type": "string", "pattern": "^UNIT-[0-9]{3,}$" },
            "tasks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^TASK-[0-9]{3,}$" } },
            "dependsOn": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^UNIT-[0-9]{3,}$" } },
            "fileScope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "covers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^(REQ|AC)-[0-9]{3,}$" } },
            "forwardVerification": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/verificationCommandRef" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "stepRef", "recoveryKind", "method", "riskRef"],
          "properties": {
            "kind": { "const": "recovery" },
            "id": { "type": "string", "pattern": "^REC-[0-9]{3,}$" },
            "stepRef": { "type": "string", "pattern": "^(UNIT|TASK)-[0-9]{3,}$" },
            "recoveryKind": { "enum": ["rollback", "compensation"] },
            "method": { "type": "string", "minLength": 1 },
            "riskRef": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
