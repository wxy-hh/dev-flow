{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dev-flow-rollback-transaction-v1",
  "title": "Dev Flow Rollback Transaction",
  "description": "Resumable journal for checkpoint rollback execution with compensation recovery",
  "type": "object",
  "required": [
    "schemaVersion",
    "transactionId",
    "featureId",
    "phase",
    "targetCheckpointId",
    "targetUnitId",
    "undoOrder",
    "previewBasisHash",
    "stateRevision",
    "backupDirectory",
    "nextFileIndex",
    "filePlan",
    "verificationAttemptIds",
    "projectConfigSha256",
    "startedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "transactionId": { "type": "string", "minLength": 1 },
    "featureId": { "type": "string", "minLength": 1 },
    "phase": {
      "type": "string",
      "enum": ["prepared", "backing-up", "rolling-back", "verifying", "committed", "compensating", "compensated"]
    },
    "targetCheckpointId": { "type": "string", "pattern": "^CP-[0-9]{3,}$" },
    "targetUnitId": { "type": "string", "pattern": "^RU-[0-9]{3,}$" },
    "undoOrder": {
      "type": "array",
      "items": { "type": "string", "pattern": "^RU-[0-9]{3,}$" },
      "minItems": 1
    },
    "undoCheckpoints": {
      "type": "array",
      "items": { "type": "string", "pattern": "^CP-[0-9]{3,}$" }
    },
    "previewBasisHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stateRevision": { "type": "integer", "minimum": 0 },
    "backupDirectory": { "type": "string", "minLength": 1 },
    "nextFileIndex": { "type": "integer", "minimum": 0 },
    "filePlan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "path"],
        "properties": {
          "action": { "type": "string", "enum": ["restore", "delete"] },
          "path": { "type": "string", "minLength": 1 },
          "blobSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "mode": { "type": "string", "pattern": "^[0-7]{3,4}$" }
        },
        "allOf": [
          {
            "if": { "properties": { "action": { "const": "restore" } } },
            "then": { "required": ["blobSha256", "mode"] }
          }
        ],
        "additionalProperties": false
      }
    },
    "verificationAttemptIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "projectConfigSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "verificationCommandHashes": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "error": { "type": "string" }
  },
  "additionalProperties": false
}
