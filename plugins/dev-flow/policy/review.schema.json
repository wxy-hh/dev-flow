{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dev-flow/review.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "reviewLedger": { "$ref": "#/$defs/reviewLedger" },
    "jobRequirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/reviewJobRequirement" },
      "uniqueItems": true
    },
    "jobCompletion": {
      "$ref": "#/$defs/reviewJobCompletion"
    },
    "samplingAttempt": {
      "$ref": "#/$defs/reviewSamplingAttempt"
    },
    "samplingProvenance": {
      "$ref": "#/$defs/reviewSamplingProvenance"
    },
    "agentAttestation": {
      "$ref": "#/$defs/reviewAgentAttestation"
    }
  },
  "$defs": {
    "reviewLedger": {
      "type": "object",
      "required": ["schemaVersion", "featureId", "revision", "stateRevision", "batches", "summary", "findingEvents"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "featureId": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 0 },
        "stateRevision": { "type": "integer", "minimum": 0 },
        "batches": { "type": "array" },
        "summary": { "type": "object" },
        "findingEvents": { "type": "array" }
      }
    },
    "reviewAssurance": {
      "enum": ["multi-perspective", "independent-sampling", "multi-agent-attested", "multi-agent-verified"]
    },
    "reviewExecutionMode": {
      "enum": ["isolated-sequential", "parallel-safe", "mcp-sampling", "native-subagent"]
    },
    "reviewRole": {
      "enum": ["requirements-coverage", "architecture-testability", "rollback-operability", "security", "data-irreversibility", "money-safety", "contract-failure", "recovery-observability", "critical-correctness"]
    },
    "reviewFindingCategory": {
      "enum": ["requirements-coverage", "architecture-testability", "rollback-operability", "security", "data-irreversibility", "money-safety", "contract-failure", "recovery-observability", "critical-correctness"]
    },
    "reviewDepth": {
      "enum": ["standard", "full"]
    },
    "reviewFindingSeverity": {
      "enum": ["blocking", "warning", "note"]
    },
    "reviewJobRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "reviewDepth"],
      "properties": {
        "role": { "$ref": "#/$defs/reviewRole" },
        "reviewDepth": { "$ref": "#/$defs/reviewDepth" }
      }
    },
    "reviewJobCompletion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverageSummary", "findings"],
      "properties": {
        "coverageSummary": { "type": "string", "minLength": 1 },
        "findings": { "type": "array" }
      }
    },
    "reviewSamplingAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestSha256", "issuedAt", "leaseExpiresAt", "status"],
      "properties": {
        "requestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "issuedAt": { "type": "string" },
        "leaseExpiresAt": { "type": "string" },
        "status": { "enum": ["issued", "failed", "submitted"] },
        "completedAt": { "type": "string" },
        "payloadSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "failureCode": { "enum": ["client-error", "timeout", "invalid-response", "validation-failed"] }
      }
    },
    "reviewSamplingProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestSha256", "issuedAt", "completedAt"],
      "properties": {
        "requestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "issuedAt": { "type": "string" },
        "completedAt": { "type": "string" }
      }
    },
    "reviewAgentAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "agentId", "issuedAt", "raw", "rawSha256", "acceptedAt"],
      "properties": {
        "host": { "enum": ["claude", "codex"] },
        "agentId": { "type": "string", "minLength": 1 },
        "issuedAt": { "type": "string" },
        "raw": { "type": "string", "minLength": 1 },
        "rawSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "acceptedAt": { "type": "string" }
      }
    }
  }
}
