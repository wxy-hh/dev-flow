{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "verification", "enforcement", "governedRoots"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 2 },
    "governedRoots": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "governedRootsExclude": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands"],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "command", "args", "cwd", "provides"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "command": { "type": "string", "minLength": 1 },
              "args": { "type": "array", "items": { "type": "string" } },
              "cwd": { "type": "string", "minLength": 1 },
              "provides": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["targeted", "behavior", "integration", "full"] } }
            }
          }
        },
        "preflightCommands": { "type": "array", "items": { "type": "string" } }
      }
    },
    "enforcement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "gitWriteRequiresLogicComplete", "oneActiveFeature", "requireExplicitHumanReply"],
      "properties": {
        "mode": { "const": "strict" },
        "gitWriteRequiresLogicComplete": { "const": true },
        "oneActiveFeature": { "const": true },
        "requireExplicitHumanReply": { "const": true }
      }
    }
  }
}
